{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mc-installer",
  "description": "Detect, download and run the MinIO client",
  "windows": ["main"],
  "permissions": [
    "os:default",
    "fs:default",
    "upload:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPLOCALDATA" },
        { "path": "$APPLOCALDATA/**" }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "mc-local", "cmd": "$APPLOCALDATA/bin/mc", "args": true },
        { "name": "mc-local-win", "cmd": "$APPLOCALDATA/bin/mc.exe", "args": true }
      ]
    },
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "mc",
          "cmd": "mc",
          "args": ["--version"]
        },
        {
          "name": "mc-alias-list",
          "cmd": "mc",
          "args": ["alias", "list", "--json"]
        },
        {
          "name": "mc-alias-remove",
          "cmd": "mc",
          "args": ["alias", "remove", { "validator": "^[A-Za-z0-9_-]+$" }]
        },
        {
          "name": "mc-ls",
          "cmd": "mc",
          "args": ["ls", "--json", { "validator": "^[A-Za-z0-9_-]+$" }]
        },
        {
          "name": "mc-alias-set",
          "cmd": "mc",
          "args": [
            "alias",
            "set",
            { "validator": "^[A-Za-z0-9_-]+$" },
            { "validator": "^https?://\\S+$" },
            { "validator": "^\\S+$" },
            { "validator": "^\\S+$" }
          ]
        },
        { "name": "mc-local", "cmd": "$APPLOCALDATA/bin/mc", "args": true },
        { "name": "mc-local-win", "cmd": "$APPLOCALDATA/bin/mc.exe", "args": true },
        {
          "name": "chmod-mc",
          "cmd": "chmod",
          "args": ["+x", { "validator": "^.+$" }]
        }
      ]
    }
  ]
}