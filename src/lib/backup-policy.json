{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCommonBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::common"
      ]
    },
    {
      "Sid": "CommonObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:ListMultipartUploadParts",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::common/*"
      ]
    },
    {
      "Sid": "ListPersonalBucketRoot",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::personal"
      ]
    },
    {
      "Sid": "ListOwnPersonalPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::personal"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "${aws:username}",
            "${aws:username}/*"
          ]
        }
      }
    },
    {
      "Sid": "OwnPersonalObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:ListMultipartUploadParts",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::personal/${aws:username}/*"
      ]
    }
  ]
}